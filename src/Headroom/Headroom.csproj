<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <OutputType Condition="$([MSBuild]::IsOSPlatform('Windows'))">WinExe</OutputType>
    <AssemblyName>Headroom</AssemblyName>
    <RootNamespace>Headroom</RootNamespace>
    <Product>Headroom</Product>
    <Title>Headroom</Title>
    <Copyright>Copyright (c) 2026 Jason Carr</Copyright>
    <Description>All your AI usage. One place.</Description>
    <ApplicationIcon>Assets/headroom-graphite.ico</ApplicationIcon>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <RuntimeFrameworkVersion>10.0.15</RuntimeFrameworkVersion>
    <IlcPackageVersion>10.0.15</IlcPackageVersion>
    <IlcOptimizationPreference>Size</IlcOptimizationPreference>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Photino.NET" Version="4.0.16" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
    <Content Remove="wwwroot/**" />
    <EmbeddedResource Include="wwwroot/*" LogicalName="web/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets/headroom.ico" LogicalName="brand.headroom.ico" />
    <EmbeddedResource Include="Assets/headroom.png" LogicalName="brand.headroom.png" />
    <EmbeddedResource Include="Assets/headroom-*.ico;Assets/headroom-*.png" LogicalName="brand.%(Filename)%(Extension)" />
    <EmbeddedResource Include="BouncyCastle-LICENSE.txt" LogicalName="licenses/BouncyCastle.txt" />
  </ItemGroup>
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" GeneratePathProperty="true" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Windows.ImplementationLibrary" Version="1.0.240803.1" GeneratePathProperty="true" ExcludeAssets="all" PrivateAssets="all" />
    <DirectPInvokeList Include="$(MSBuildProjectDirectory)/../../native/Photino.Windows.pinvoke.txt" />
    <NativeLibrary Include="$(MSBuildProjectDirectory)/../../native/bin/x64/Release/Photino.Static.lib" />
    <NativeLibrary Include="$(PkgMicrosoft_Web_WebView2)/build/native/x64/WebView2LoaderStatic.lib" />
    <NativeLibrary Include="user32.lib;shell32.lib;gdi32.lib;comdlg32.lib;shlwapi.lib;shcore.lib;urlmon.lib;ole32.lib;oleaut32.lib;uuid.lib;version.lib;windowsapp.lib;propsys.lib" />
  </ItemGroup>
  <Target Name="BuildStaticPhotino" BeforeTargets="IlcCompile" Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)/../../tools/Build-Native.ps1&quot; -WebView2Root &quot;$(PkgMicrosoft_Web_WebView2)&quot; -WilRoot &quot;$(PkgMicrosoft_Windows_ImplementationLibrary)&quot;" />
  </Target>
  <Target Name="RemoveDynamicPhotinoFromPublish" AfterTargets="ComputeFilesToPublish" Condition="'$(RuntimeIdentifier)' == 'win-x64' and '$(PublishAot)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Filename)%(Extension)' == 'Photino.Native.dll' or '%(Filename)%(Extension)' == 'WebView2Loader.dll'" />
    </ItemGroup>
  </Target>
</Project>
